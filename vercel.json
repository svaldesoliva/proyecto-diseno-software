{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm --prefix frontend ci",
  "buildCommand": "npm test && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/:__route*", "destination": "/api/index" }
  ],
  "functions": {
    "api/**/*.ts": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron/prices", "schedule": "0 12 * * *" }
  ]
}
