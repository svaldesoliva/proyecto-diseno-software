APP_ORIGIN=http://localhost:5173
# Supabase > Connect > Session pooler. Encode special characters in the password.
# Vercel's Supabase integration supplies POSTGRES_URL; DATABASE_URL is optional there.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CRON_SECRET=
